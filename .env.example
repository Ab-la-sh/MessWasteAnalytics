# --- Database (Supabase) ---------------------------------------------------
# Pooled connection (Supavisor/pgbouncer, port 6543). Used by the running app.
# Supabase dashboard -> Connect -> ORMs -> Prisma. URL-encode special characters
# in the password (e.g. @ -> %40, # -> %23, / -> %2F).
DATABASE_URL="postgresql://postgres.<project-ref>:<url-encoded-password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct connection (port 5432). Used only by `prisma migrate deploy`.
DIRECT_URL="postgresql://postgres.<project-ref>:<url-encoded-password>@<region>.pooler.supabase.com:5432/postgres"

# For purely local Postgres, set both to the same URL:
# DATABASE_URL="postgresql://<user>@localhost:5432/messwaste?schema=public"
# DIRECT_URL="postgresql://<user>@localhost:5432/messwaste?schema=public"

# --- Auth ------------------------------------------------------------------
# Must be at least 32 characters in production (the app refuses to boot otherwise).
# Generate with: openssl rand -base64 48
JWT_SECRET=""

# Session lifetime in seconds (default 28800 = 8 hours)
JWT_EXPIRES_IN_SECONDS=28800

# --- Weather (Open-Meteo, no API key needed) --------------------------------
# Names must match what src/lib/weather.ts reads. Both are optional: the
# defaults below are used when these are unset.
OPEN_METEO_FORECAST_URL="https://api.open-meteo.com/v1/forecast"
OPEN_METEO_ARCHIVE_URL="https://archive-api.open-meteo.com/v1/archive"

# --- Seeding (only read by `npm run db:seed`) --------------------------------
# Set to false in production to seed reference data + users only (no demo waste records).
SEED_DEMO_RECORDS=true
# Optional: override the demo passwords used for seeded users.
# SEED_ADMIN_PASSWORD=""
# SEED_COLLECTOR_PASSWORD=""
