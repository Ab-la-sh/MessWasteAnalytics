# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/messwaste?schema=public"

# JWT signing secret — generate with: openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-string"

# Access token lifetime, in seconds (default 8 hours)
JWT_EXPIRES_IN_SECONDS=28800

# Open-Meteo has no API key requirement; left here in case you swap providers later.
WEATHER_API_BASE_URL="https://archive-api.open-meteo.com/v1/archive"
WEATHER_FORECAST_API_BASE_URL="https://api.open-meteo.com/v1/forecast"
